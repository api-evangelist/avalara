        {
          "id": "b7c5d695-4842-49c9-aab6-ad44bcade042",
          "name": "Avalara GetMySubscription",
          "request": {
            "name": "Avalara GetMySubscription",
            "description": {
              "content": "Returns a subscription object for the current account, or 404 Not Found if this subscription is not enabled for this account.\n            \nThis API will return an error if it is called with invalid authentication credentials.\n            \nThis API is intended to help you determine whether you have the necessary subscription to use certain API calls\nwithin AvaTax.  You can examine the subscriptions returned from this API call to look for a particular product\nor subscription to provide useful information to the current user as to whether they are entitled to use\nspecific features of AvaTax.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "utilities",
                "subscriptions",
                ":serviceTypeId"
              ],
              "host": [
                "{{api-v2-utilities-subscriptions-serviceTypeId-Url}}"
              ],
              "query": [],
              "variable": [
                {
