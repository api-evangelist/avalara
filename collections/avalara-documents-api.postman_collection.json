    "_postman_id": "1b7431ed-521a-4d83-9ab7-52d3d59b4205",
    "name": "Avalara E-Invoicing REST Documents API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Avalara E-Invoicing REST API supports electronic invoicing compliance workflows for cross-border and domestic transactions. It enables submission, validation, and management of e-invoices in compliance with mandates from tax authorities worldwide, supporting formats like UBL, Peppol, and country-specific standards.\n\nContact Support:\n Name: Avalara Developer Relations\n Email: developer.relations@avalara.com",
      "type": "text/plain"
    }
  }
