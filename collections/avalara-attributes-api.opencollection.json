{
  "opencollection": "1.0.0",
  "info": {
    "name": "Avalara CertCapture Attributes API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Attributes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Avalara List Certificate Attributes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.certcapture.com/v2/attributes"
          },
          "docs": "Avalara List Certificate Attributes"
        }
      ]
    }
  ],
  "bundled": true
}