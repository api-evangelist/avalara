{
  "opencollection": "1.0.0",
  "info": {
    "name": "Avalara Item Classification HS Codes API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "HS Codes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Avalara Get Classification Results",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.avalara.com/classification/v2/classification-requests/:requestId/results",
            "params": [
              {
                "name": "requestId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieves the HS Code classification results for a completed classification request."
        },
        {
          "info": {
            "name": "Avalara Get HS Code Details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.avalara.com/classification/v2/hs-codes/:hsCode",
            "params": [
              {
                "name": "hsCode",
                "value": "",
                "type": "path",
                "description": "The HS Code to look up"
              },
              {
                "name": "country",
                "value": "",
                "type": "query",
                "description": "ISO 3166-1 alpha-2 country code for country-specific details"
              }
            ]
          },
          "docs": "Retrieves detailed information for a specific HS Code."
        }
      ]
    }
  ],
  "bundled": true
}