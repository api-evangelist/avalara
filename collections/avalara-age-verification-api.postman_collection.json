                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"isOfAge\": false,\n  \"failureCodes\": [\n    {\n      \"isOfAge\": false,\n      \"failureCodes\": [\n        \"deceased\",\n        \"dob_unverifiable\"\n      ]\n    },\n    {\n      \"isOfAge\": false,\n      \"failureCodes\": [\n        \"deceased\",\n        \"dob_unverifiable\"\n      ]\n    }\n  ]\n}",
