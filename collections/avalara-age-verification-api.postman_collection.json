      },
      "item": [
        {
          "id": "c1823242-8023-4f7a-8cab-c04a3fc1b60e",
          "name": "Determines whether an individual meets or exceeds the minimum legal drinking age.",
          "request": {
            "name": "Determines whether an individual meets or exceeds the minimum legal drinking age.",
            "description": {
              "content": "The request must meet the following criteria in order to be evaluated:\n* *firstName*, *lastName*, and *address* are required fields.\n* One of the following sets of attributes are required for the *address*:\n  * *line1, city, region*\n  * *line1, postalCode*\n\nOptionally, the transaction and its lines may use the following parameters:\n* A *DOB* (Date of Birth) field. The value should be ISO-8601 compliant (e.g. 2020-07-21).\n* Beyond the required *address* fields above, a *country* field is permitted\n  * The valid values for this attribute are [*US, USA*]\n\n**Security Policies**\nThis API depends on the active subscription *AgeVerification*",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                "ageverification",
                "verify"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "simulatedFailureCode",
                  "value": "<string>",
                  "description": "(Optional) The failure code included in the simulated response of the endpoint. Note that this endpoint is only available in Sandbox for testing purposes."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"<string>\",\n  \"lastName\": \"<string>\",\n  \"address\": {\n    \"line1\": \"<string>\",\n    \"city\": \"<string>\",\n    \"region\": \"<string>\",\n    \"country\": \"<string>\",\n    \"postalCode\": \"<string>\"\n  },\n  \"DOB\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "90bc658f-dd41-49b9-8be8-268ae6610178",
              "name": "An AgeVerificationResult object.",
              "originalRequest": {
