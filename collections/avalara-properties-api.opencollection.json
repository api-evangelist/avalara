{
  "opencollection": "1.0.0",
  "info": {
    "name": "Avalara MyLodgeTax Properties API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Properties",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Avalara List Registered Properties",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.avalara.com/mylodgetax/v1/properties"
          },
          "docs": "Avalara List Registered Properties"
        },
        {
          "info": {
            "name": "Avalara Register a Rental Property",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.avalara.com/mylodgetax/v1/properties",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Avalara Register a Rental Property"
        }
      ]
    }
  ],
  "bundled": true
}