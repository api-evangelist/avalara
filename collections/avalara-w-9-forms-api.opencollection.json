            "url": "https://api.avalara.com/1099/v1/w9/:w9Id",
            "params": [
              {
                "name": "w9Id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Avalara Get a Completed W-9 Form"
        }
      ]
    }
  ],
  "bundled": true
}