    "_postman_id": "15a38148-19cb-4b71-a14d-151719f0fad2",
    "name": "Avalara AvaTax Brazil Electronic Invoices API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The AvaTax Brazil API provides tax calculation, electronic invoice (NF-e, NFS-e, NFC-e) issuance, and transaction management for businesses with a physical presence in Brazil. It supports Brazilian federal, state, and municipal taxes including ICMS, IPI, PIS, COFINS, ISS, and more.\n\nContact Support:\n Name: Avalara Developer Relations\n Email: developer.relations@avalara.com",
      "type": "text/plain"
    }
